# Server Port & Environment
PORT=3000

# PostgreSQL Connection (Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cron Job Webhook Authentication (x-cron-secret header or ?secret= query)
CRON_SECRET=your_long_random_cron_secret_key

# SMTP / Email Alerts Configuration (Gmail, Brevo, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="VOLP Desk Alerts <your_email@gmail.com>"

